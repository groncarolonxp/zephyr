/dts-v1/;

#include <nxp/imxrt/nxp_rt118x_cm33.dtsi>
#include <nxp/imxrt/nxp_rt1186.dtsi>
#include "frdm_imxrt1186.dtsi"
#include <freq.h>
#include <zephyr/dt-bindings/gpio/arduino-header-r3.h>


/ {
	model = "NXP FRDM-IMXRT1186 board";
	compatible = "nxp,mimxrt1186";

	chosen {
		zephyr,sram = &hyperram0;
		zephyr,dtcm = &dtcm;
		zephyr,itcm = &itcm;
		zephyr,flash-controller = &ext_flash_ctrl;
		zephyr,flash = &w25q128jv;
		zephyr,code-partition = &slot0_partition;
		zephyr,code-m7-partition = &slot1_partition;
		zephyr,console = &lpuart1;
		zephyr,shell-uart = &lpuart1;
	};

	hyperram0: memory@38000000 {
		/* Winbond W957A8MFYA5K */
		device_type = "memory";
		reg = <0x38000000 DT_SIZE_M(8)>;
		zephyr,memory-attr = <DT_MEM_ARM(ATTR_MPU_RAM)>;
		/*
		 * HyperRAM on FRDM-IMXRT1186 is initialized by ROM bootloader
		 * reading the XMCD configuration from xip/frdmimxrt1186_flexspi_nor_config.c
		 */
		status = "okay";
	};

	qspi_flash: memory@14000000 {
		device_type = "memory";
		reg = <0x14000000 DT_SIZE_M(16)>;
		zephyr,memory-attr = <DT_MEM_ARM(ATTR_MPU_FLASH)>;
		status = "okay";
	};


	arduino_header: connector {
		compatible = "arduino-header-r3";
		#gpio-cells = <2>;
		gpio-map-mask = <0xffffffff 0xffffffc0>;
		gpio-map-pass-thru = <0 0x3f>;
		gpio-map = <ARDUINO_HEADER_R3_D0 0 &gpio1 9 0>,
				<ARDUINO_HEADER_R3_D1 0 &gpio1 8 0>,
				<ARDUINO_HEADER_R3_D2 0 &gpio4 15 0>,
				<ARDUINO_HEADER_R3_D3 0 &gpio4 6 0>,
				<ARDUINO_HEADER_R3_D4 0 &gpio4 12 0>,
				<ARDUINO_HEADER_R3_D5 0 &gpio4 13 0>,
				<ARDUINO_HEADER_R3_D6 0 &gpio4 7 0>,
				<ARDUINO_HEADER_R3_D7 0 &gpio4 8 0>,
				<ARDUINO_HEADER_R3_D8 0 &gpio4 3 0>,
				<ARDUINO_HEADER_R3_D9 0 &gpio2 16 0>,
				<ARDUINO_HEADER_R3_D10 0 &gpio2 25 0>,    /* GPIO_EMC_B1_25 - SPI CS */
				<ARDUINO_HEADER_R3_D11 0 &gpio2 24 0>,    /* GPIO_EMC_B1_24 - SPI MOSI */
				<ARDUINO_HEADER_R3_D12 0 &gpio2 23 0>,    /* GPIO_EMC_B1_23 - SPI MISO */
				<ARDUINO_HEADER_R3_D13 0 &gpio2 22 0>,    /* GPIO_EMC_B1_22 - SPI SCK */
				<ARDUINO_HEADER_R3_D14 0 &gpio3 29 0>,
				<ARDUINO_HEADER_R3_D15 0 &gpio3 30 0>,
				<ARDUINO_HEADER_R3_A0 0 &gpio4 10 0>,
				<ARDUINO_HEADER_R3_A1 0 &gpio4 11 0>,
				<ARDUINO_HEADER_R3_A2 0 &gpio4 4 0>,
				<ARDUINO_HEADER_R3_A3 0 &gpio4 5 0>,
				<ARDUINO_HEADER_R3_A4 0 &gpio4 17 0>,
				<ARDUINO_HEADER_R3_A5 0 &gpio4 16 0>;
	};
};


arduino_spi: &lpspi4 {
	status = "okay";
};
arduino_i2c: &lpi2c3 {
	status = "okay";
};
&cpu0 {
	clock-frequency = <DT_FREQ_M(240)>;
};

&lpuart1 {
	status = "okay";
	current-speed = <115200>;
};

&flexspi {
	status = "okay";
};

&flexspi2 {
	status = "okay";
};

&systick {
	status = "okay";
};

&lpadc1 {
	status = "okay";
};

&sema1 {
	domain-id = <8>;
	status = "okay";
};
 